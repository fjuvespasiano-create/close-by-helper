{
  "name": "agenddaqui-whatsapp-bot",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Bot WhatsApp com estratégias anti-ban profissionais (spintax, warm-up, opt-out, presence typing).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "send:auto": "node src/index.js --mode=auto",
    "send:manual": "node src/index.js --mode=manual",
    "send:one": "node src/index.js --mode=one",
    "warmup:status": "node src/index.js --mode=warmup-status",
    "warmup:reset": "node src/index.js --mode=warmup-reset",
    "optout:add": "node src/index.js --mode=optout-add"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.23.0"
  }
}
